{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "hscript",
      "camelcase": "hscript",
      "title": "hscript",
      "scope": "source.hscript",
      "file-types": [
        "hx",
        "hxs",
        "hscript"
      ],
      "injection-regex": "^hscript$",
      "class-name": "TreeSitterHscript"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "Treesitter parser for hscript",
    "authors": [
      {
        "name": "shifterbit",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-hscript",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": false,
    "zig": false
  },
  "theme": {
    "keyword": "purple",
    "function": "blue",
    "type": "green",
    "number": "brown"
  }
}
